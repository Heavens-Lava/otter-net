<!--
  otter-net's Windows installer (MSI), built by tools\package.ps1 -Installer
  through otter-net.wixproj (WiX 5, SDK-style).

  - Installs for the current user only, no administrator rights, into
    %LOCALAPPDATA%\Programs\otter-net: exactly the files of the release ZIP
    (otter.exe, otter-desktop.exe when it is built, LICENSE, README.md,
    VERSION, THIRD-PARTY-NOTICES.txt, SHA256SUMS).
  - Puts that folder first on the user's PATH, so a new terminal's `otter` is
    otter-net's, also when the PowerShell Otter (otterPS) is on the PATH
    too. otter-net still finds otterPS where Install-Otter.ps1 put it
    (%LOCALAPPDATA%\Otter\1.0.1) for what it hands over.
  - Uninstalling (Settings > Apps) removes the files, the folder, the PATH
    entry and HKCU\Software\otter-net.
  - Its own UpgradeCode, distinct from otterPS's MSI
    (F2065F2E-9E7A-405C-810C-3826A1DAAE39): a newer otter-net MSI replaces an
    older one (same version too: release candidates share 1.0.1), and the two
    products never replace each other. Whether otter-net's installer should
    take over otterPS's identity is a decision for publishing
    (docs/PACKAGING.md).

  Variables (from tools\package.ps1):
    ProductVersion  numbers only, for Windows Installer (1.0.1)
    PackageVersion  the full version from VERSION (1.0.1-rc.1)
  The files' components come from a fragment tools\package.ps1 generates
  (ComponentGroup OtterNetFiles).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Otter (otter-net) $(var.PackageVersion)"
           Manufacturer="Jeffrey Macy"
           Version="$(var.ProductVersion)"
           UpgradeCode="B6DDDF92-EF9A-4FC0-ACA2-E1E3B3413E9B"
           Scope="perUser"
           Language="1033">

    <SummaryInformation Description="Otter (otter-net) $(var.PackageVersion) - unsigned release candidate" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of otter-net is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- What Settings > Apps shows. -->
    <Property Id="ARPURLINFOABOUT" Value="https://otterprogramming.com" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Heavens-Lava/otter-net/issues" />
    <Property Id="ARPCOMMENTS" Value="Otter, native implementation - release candidate $(var.PackageVersion), unsigned." />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="otter-net" />
      </Directory>
    </StandardDirectory>

    <!-- `otter` on the user's PATH; the registry value is the component's key
         (a per-user component needs one, ICE38). -->
    <Component Id="OtterNetOnPath" Directory="INSTALLFOLDER" Guid="6CFBA9A4-2DD8-47B6-804B-A9ABD2AF4371">
      <RegistryValue Root="HKCU" Key="Software\otter-net" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\otter-net" Name="Version" Type="string" Value="$(var.PackageVersion)" />
      <Environment Id="OtterNetPath" Name="PATH" Value="[INSTALLFOLDER]" Part="first" Action="set" System="no" Permanent="no" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <!-- Removed only when empty: other programs install there too. -->
      <RemoveFolder Id="RemoveUserProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
      <RemoveRegistryKey Root="HKCU" Key="Software\otter-net" Action="removeOnUninstall" />
    </Component>

    <Feature Id="OtterNet">
      <ComponentRef Id="OtterNetOnPath" />
      <ComponentGroupRef Id="OtterNetFiles" />
    </Feature>
  </Package>
</Wix>
