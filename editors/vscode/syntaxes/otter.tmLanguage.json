{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Otter",
    "scopeName": "source.otter",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#function-def" },
        { "include": "#type-def" },
        { "include": "#ui-variants" },
        { "include": "#ui-components" },
        { "include": "#control-keywords" },
        { "include": "#io-keywords" },
        { "include": "#ui-properties" },
        { "include": "#operators" },
        { "include": "#block-terminator" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.otter",
                    "match": "#.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.otter",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.otter",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.decimal.otter",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.otter",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.otter",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.otter",
                    "match": "\\bempty\\b"
                },
                {
                    "name": "constant.language.date.otter",
                    "match": "\\b(now|today)\\b"
                }
            ]
        },
        "function-def": {
            "patterns": [
                {
                    "match": "^\\s*(to)\\s+([A-Za-z][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.control.declaration.function.otter" },
                        "2": { "name": "entity.name.function.otter" }
                    }
                }
            ]
        },
        "type-def": {
            "patterns": [
                {
                    "match": "^\\s*(a)\\s+([A-Za-z][A-Za-z0-9_]*)\\s+(has)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.otter" },
                        "2": { "name": "entity.name.type.class.otter" },
                        "3": { "name": "keyword.other.otter" }
                    }
                }
            ]
        },
        "ui-variants": {
            "patterns": [
                {
                    "name": "storage.modifier.variant.otter",
                    "match": "\\b(primary|secondary|danger|outline|ghost)\\b(?=\\s+(?:button|badge|card)\\b)"
                }
            ]
        },
        "ui-components": {
            "patterns": [
                {
                    "name": "support.type.ui.otter",
                    "match": "\\b(text box|text area|radio button|progress bar|check box|drop down|page|window|card|grid|row|column|button|dropdown|checkbox|toggle|switch|radio|slider|range|progress|badge|tag|table|link|dialog|modal|panel|canvas|list)\\b"
                }
            ]
        },
        "control-keywords": {
            "patterns": [
                {
                    "name": "keyword.control.otter",
                    "match": "\\b(if|otherwise|while|repeat|times|for each|each|count from|from|to|return|stop|try|fail|when|clicked|changed|on connection|on data|use|as|has|make|into|put|in|show)\\b"
                }
            ]
        },
        "io-keywords": {
            "patterns": [
                {
                    "name": "keyword.other.io.otter",
                    "match": "\\b(say|ask|secretly|with|read|write|append|convert|format|find|split|join|replace|sort|reverse|add|remove|copy|clipboard|length of|are empty|are)\\b"
                }
            ]
        },
        "ui-properties": {
            "patterns": [
                {
                    "name": "variable.other.property.otter",
                    "match": "\\b(theme|subtitle|placeholder|showvalue|hideheader|letterspacing|lineheight|fontfamily|whitespace|customstyle|background|foreground|maxwidth|columns|spacing|padding|options|checked|disabled|variant|margin|border|radius|scroll|label|title|value|error|align|width|height|hint|rows|wrap|text|size|weight|url|min|max|step|full|spread|middle)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.otter",
                    "match": "\\b(is not|is at least|is at most|is greater than|is less than|is|contains|between)\\b"
                },
                {
                    "name": "keyword.operator.arithmetic.otter",
                    "match": "\\b(plus|minus|times|divided by)\\b"
                },
                {
                    "name": "keyword.operator.logical.otter",
                    "match": "\\b(and|or|not)\\b"
                },
                {
                    "name": "keyword.operator.accessor.otter",
                    "match": "\\bof\\b"
                }
            ]
        },
        "block-terminator": {
            "patterns": [
                {
                    "name": "punctuation.terminator.period.otter",
                    "match": "^\\s*(\\.)\\s*$"
                }
            ]
        }
    }
}
