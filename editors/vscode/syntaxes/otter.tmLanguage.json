{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Otter",
    "scopeName": "source.otter",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#function-def" },
        { "include": "#type-def" },
        { "include": "#control-keywords" },
        { "include": "#io-keywords" },
        { "include": "#operators" },
        { "include": "#block-terminator" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.otter",
                    "match": "#.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.otter",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.otter",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.decimal.otter",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.otter",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.otter",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.otter",
                    "match": "\\bempty\\b"
                },
                {
                    "name": "constant.language.date.otter",
                    "match": "\\b(now|today)\\b"
                }
            ]
        },
        "function-def": {
            "patterns": [
                {
                    "match": "^\\s*(to)\\s+([A-Za-z][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.control.declaration.function.otter" },
                        "2": { "name": "entity.name.function.otter" }
                    }
                }
            ]
        },
        "type-def": {
            "patterns": [
                {
                    "match": "^\\s*(a)\\s+([A-Za-z][A-Za-z0-9_]*)\\s+(has)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.otter" },
                        "2": { "name": "entity.name.type.class.otter" },
                        "3": { "name": "keyword.other.otter" }
                    }
                }
            ]
        },
        "control-keywords": {
            "patterns": [
                {
                    "name": "keyword.control.otter",
                    "match": "\\b(if|otherwise|while|repeat|times|for each|count from|to|return|stop|try|when|on connection|on data|use|as|has|make|into)\\b"
                }
            ]
        },
        "io-keywords": {
            "patterns": [
                {
                    "name": "keyword.other.io.otter",
                    "match": "\\b(say|ask|secretly|with|read|write|append|convert|format|find|split|join|replace|sort|reverse|add|remove|length of|are empty)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.otter",
                    "match": "\\b(is not|is at least|is at most|is greater than|is less than|is|contains|between)\\b"
                },
                {
                    "name": "keyword.operator.arithmetic.otter",
                    "match": "\\b(plus|minus|times|divided by)\\b"
                },
                {
                    "name": "keyword.operator.logical.otter",
                    "match": "\\b(and|or|not)\\b"
                },
                {
                    "name": "keyword.operator.accessor.otter",
                    "match": "\\bof\\b"
                }
            ]
        },
        "block-terminator": {
            "patterns": [
                {
                    "name": "punctuation.terminator.period.otter",
                    "match": "^\\s*(\\.)\\s*$"
                }
            ]
        }
    }
}
