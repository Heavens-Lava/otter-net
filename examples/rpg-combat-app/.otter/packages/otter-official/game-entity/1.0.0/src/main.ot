# game-entity - Otter Reusable Game Actor & Combat Library
# Provides Actor, InventoryItem, Cooldown, Inventory, Equipment,
# combat mechanics, leveling, inventory management, and state persistence

a Actor has
    name
    health
    maxHealth
    level
    isAlive
    attackBonus
    defenseBonus
    experience
.

a InventoryItem has
    itemName
    itemKind
    itemPower
    isStackable
    itemCount
    maxStack
.

a Cooldown has
    skillName
    cooldownSeconds
    lastUsedSeconds
.

a Inventory has
    capacity
    currentCount
    items
.

a Equipment has
    weapon
    armor
    accessory
.

to createActor name hp lvl
    e is a Actor
    name of e is name
    health of e is hp
    maxHealth of e is hp
    level of e is lvl
    isAlive of e is true
    attackBonus of e is 0
    defenseBonus of e is 0
    experience of e is 0
    return e
.

to createItem itemName itemKind itemPower
    item is a InventoryItem
    itemName of item is itemName
    itemKind of item is itemKind
    itemPower of item is itemPower
    isStackable of item is false
    itemCount of item is 1
    maxStack of item is 1
    return item
.

to createStackableItem itemName itemKind itemPower countVal maxStackVal
    item is a InventoryItem
    itemName of item is itemName
    itemKind of item is itemKind
    itemPower of item is itemPower
    isStackable of item is true
    itemCount of item is countVal
    maxStack of item is maxStackVal
    return item
.

to applyDamage actor amount
    if amount is at most 0
        return health of actor
    .
    cur is health of actor
    newHp is cur minus amount
    if newHp is at most 0
        health of actor is 0
        isAlive of actor is false
        return 0
    .
    health of actor is newHp
    return newHp
.

to restoreHealth actor amount
    if isAlive of actor is false
        return 0
    .
    cur is health of actor
    maxHp is maxHealth of actor
    newHp is cur plus amount
    if newHp is greater than maxHp
        health of actor is maxHp
        return maxHp
    .
    health of actor is newHp
    return newHp
.

to reviveActor actor hp
    isAlive of actor is true
    maxHp is maxHealth of actor
    newHp is hp
    if newHp is greater than maxHp
        newHp is maxHp
    .
    health of actor is newHp
    return newHp
.

to levelUp actor
    curLvl is level of actor
    level of actor is curLvl plus 1
    curMax is maxHealth of actor
    newMax is curMax plus 25
    maxHealth of actor is newMax
    health of actor is newMax
    attackBonus of actor is attackBonus of actor plus 5
    defenseBonus of actor is defenseBonus of actor plus 3
    return level of actor
.

to gainExperience actor amount neededPerLevel
    curExp is experience of actor
    newExp is curExp plus amount
    experience of actor is newExp
    if newExp is at least neededPerLevel
        levelUp actor
        experience of actor is newExp minus neededPerLevel
        return true
    .
    return false
.

to createCooldown name cd
    cooldownObj is a Cooldown
    skillName of cooldownObj is name
    cooldownSeconds of cooldownObj is cd
    lastUsedSeconds of cooldownObj is 0 minus 9999
    return cooldownObj
.

to isCooldownReady cooldownObj nowSeconds
    last is lastUsedSeconds of cooldownObj
    duration is cooldownSeconds of cooldownObj
    elapsed is nowSeconds minus last
    if elapsed is at least duration
        return true
    .
    return false
.

to triggerCooldown cooldownObj nowSeconds
    checkReady is isCooldownReady cooldownObj nowSeconds
    if checkReady is true
        lastUsedSeconds of cooldownObj is nowSeconds
        return true
    .
    return false
.

to createInventory slots
    newInv is a Inventory
    capacity of newInv is slots
    currentCount of newInv is 0
    emptyItems are empty
    items of newInv is emptyItems
    return newInv
.

to getInventoryCount inv
    return currentCount of inv
.

to getInventoryCapacity inv
    return capacity of inv
.

to findItemInInventory inv targetName
    itemList is items of inv
    for each it in itemList
        if itemName of it is targetName
            return it
        .
    .
    return gone
.

to addItemToInventory inv item
    curCount is currentCount of inv
    cap is capacity of inv
    
    # Check if stackable with existing item
    if isStackable of item is true
        existing is findItemInInventory inv itemName of item
        if existing is not gone
            existingCount is itemCount of existing
            addCount is itemCount of item
            newCount is existingCount plus addCount
            maxLimit is maxStack of existing
            if newCount is at most maxLimit
                itemCount of existing is newCount
                return true
            .
        .
    .

    # Check capacity limit
    if curCount is at least cap
        return false
    .

    currentCount of inv is curCount plus 1
    itemList is items of inv
    add item to itemList
    return true
.

to removeItemFromInventory inv targetName
    itemList is items of inv
    newItems are empty
    removed is false
    for each it in itemList
        if not removed and itemName of it is targetName
            removed is true
        otherwise
            add it to newItems
        .
    .
    if removed is true
        items of inv is newItems
        currentCount of inv is currentCount of inv minus 1
        return true
    .
    return false
.

to createEquipment
    newEq is a Equipment
    weapon of newEq is gone
    armor of newEq is gone
    accessory of newEq is gone
    return newEq
.

to equipItem equipment item
    kind is itemKind of item
    if kind is "weapon"
        weapon of equipment is item
        return true
    .
    if kind is "armor"
        armor of equipment is item
        return true
    .
    if kind is "accessory"
        accessory of equipment is item
        return true
    .
    return false
.

to unequipSlot equipment slotName
    if slotName is "weapon"
        prevW is weapon of equipment
        weapon of equipment is gone
        return prevW
    .
    if slotName is "armor"
        prevA is armor of equipment
        armor of equipment is gone
        return prevA
    .
    if slotName is "accessory"
        prevAcc is accessory of equipment
        accessory of equipment is gone
        return prevAcc
    .
    return gone
.

to getEquipmentAttackBonus equipment
    bonus is 0
    w is weapon of equipment
    if w is not gone
        bonus is bonus plus itemPower of w
    .
    acc is accessory of equipment
    if acc is not gone
        if itemKind of acc is "attack_accessory"
            bonus is bonus plus itemPower of acc
        .
    .
    return bonus
.

to getEquipmentDefenseBonus equipment
    bonus is 0
    arm is armor of equipment
    if arm is not gone
        bonus is bonus plus itemPower of arm
    .
    acc is accessory of equipment
    if acc is not gone
        if itemKind of acc is "defense_accessory"
            bonus is bonus plus itemPower of acc
        .
    .
    return bonus
.

to buildItemRecord it
    itemData has
        itemName is itemName of it
        itemKind is itemKind of it
        itemPower is itemPower of it
        isStackable is isStackable of it
        itemCount is itemCount of it
        maxStack is maxStack of it
    .
    return itemData
.

to serializeGameState actor inv equip
    rawItems are empty
    for each it in items of inv
        record is buildItemRecord it
        add record to rawItems
    .

    equipData has
        hasWeapon is false
        hasArmor is false
    .
    w is weapon of equip
    if w is not gone
        hasWeapon of equipData is true
        weaponName of equipData is itemName of w
        weaponPower of equipData is itemPower of w
    .
    armItem is armor of equip
    if armItem is not gone
        hasArmor of equipData is true
        armorName of equipData is itemName of armItem
        armorPower of equipData is itemPower of armItem
    .

    gameState has
        name is name of actor
        health is health of actor
        maxHealth is maxHealth of actor
        level is level of actor
        isAlive is isAlive of actor
        attackBonus is attackBonus of actor
        defenseBonus is defenseBonus of actor
        experience is experience of actor
        inventoryCapacity is capacity of inv
        inventoryCount is currentCount of inv
        inventoryItems is rawItems
        equipment is equipData
    .
    return gameState
.

to deserializeGameState stateData
    # 1. Reconstruct Actor
    restoredAct is createActor name of stateData health of stateData level of stateData
    maxHealth of restoredAct is maxHealth of stateData
    isAlive of restoredAct is isAlive of stateData
    attackBonus of restoredAct is attackBonus of stateData
    defenseBonus of restoredAct is defenseBonus of stateData
    experience of restoredAct is experience of stateData

    # 2. Reconstruct Inventory
    restoredInv is createInventory inventoryCapacity of stateData
    for each rawIt in inventoryItems of stateData
        it is createItem itemName of rawIt itemKind of rawIt itemPower of rawIt
        isStackable of it is isStackable of rawIt
        itemCount of it is itemCount of rawIt
        maxStack of it is maxStack of rawIt
        addItemToInventory restoredInv it
    .

    # 3. Reconstruct Equipment
    restoredEq is createEquipment
    eqData is equipment of stateData
    if hasWeapon of eqData is true
        wItem is createItem weaponName of eqData "weapon" weaponPower of eqData
        equipItem restoredEq wItem
    .
    if hasArmor of eqData is true
        aItem is createItem armorName of eqData "armor" armorPower of eqData
        equipItem restoredEq aItem
    .

    bundle has
        actor is restoredAct
        inventory is restoredInv
        equipment is restoredEq
    .
    return bundle
.
