# Otter Pulse — Microservice Telemetry & Web Dashboard (Flagship Reference App)
# Consumes Schema v2 Packs: file-helpers (1.0.1), text-utils (1.0.1), math-utils (1.0.1)
# Executes real outbound HTTP health probes via Otter's native Http.cs client + timers.

use "../.otter/packages/otter-official/file-helpers/1.0.1/src/main.ot"
use "../.otter/packages/otter-official/text-utils/1.0.1/src/main.ot"
use "../.otter/packages/otter-official/math-utils/1.0.1/src/main.ot"

a ServiceRecord has
    name
    slug
    port
    category
    uptime
    latencyMs
    healthScore
    checks
    probeUrl
    status
    lastError
.

to defaultProbeUrl portNum
    urlParts are
        "http://127.0.0.1:"
        portNum
        "/health"
    .
    join urlParts with "" into builtUrl
    return builtUrl
.

to calculateHealthScore latencyMs targetUptime
    # Health score from 5-100:
    # 1. Latency penalty: penalize latency over 50ms (1 pt per 2ms)
    # 2. Uptime penalty: if target uptime < 99.9%, penalize (100 - uptime) * 10
    score is 100
    if latencyMs is greater than 50
        latExcess is latencyMs minus 50
        latPenalty is latExcess divided by 2
        score is score minus latPenalty
    .
    if targetUptime is less than 99.9
        upDeficit is 99.9 minus targetUptime
        upPenalty is upDeficit times 10
        score is score minus upPenalty
    .
    scoreClamped is clamp score 5 100
    return scoreClamped
.

to createServiceRecord sName sPort sCategory sTargetUptime sProbeUrl
    svc is a ServiceRecord
    name of svc is sName
    slug of svc is slugify sName
    portNum is sPort plus 0
    port of svc is portNum
    category of svc is sCategory
    uptime of svc is sTargetUptime
    latencyMs of svc is 24
    healthScore of svc is calculateHealthScore 24 sTargetUptime
    checks of svc is 0
    if sProbeUrl is gone or sProbeUrl is ""
        probeUrl of svc is defaultProbeUrl portNum
    otherwise
        probeUrl of svc is sProbeUrl
    .
    status of svc is "healthy"
    lastError of svc is ""
    return svc
.

to buildServiceDict svc
    d has
        name is name of svc
        slug is slug of svc
        port is port of svc
        category is category of svc
        uptime is uptime of svc
        latencyMs is latencyMs of svc
        healthScore is healthScore of svc
        checks is checks of svc
        probeUrl is probeUrl of svc
        status is status of svc
        lastError is lastError of svc
    .
    return d
.

to findServiceBySlug services targetSlug
    for each s in services
        if slug of s is targetSlug
            return s
        .
    .
    return gone
.

to saveServicesList services filePath
    rawList are empty
    for each s in services
        d is buildServiceDict s
        add d to rawList
    .
    convert rawList to json into rawJson
    writeSafe filePath rawJson
    return true
.

to createServiceFromDict item
    s is a ServiceRecord
    name of s is name of item
    slug of s is slug of item
    port of s is port of item
    category of s is category of item
    uptime of s is uptime of item
    latencyMs of s is latencyMs of item
    healthScore of s is healthScore of item
    checks of s is checks of item

    loadedUrl is ""
    try
        loadedUrl is probeUrl of item
    otherwise
        loadedUrl is ""
    .
    if loadedUrl is gone or loadedUrl is ""
        sPortVal is port of s
        probeUrl of s is defaultProbeUrl sPortVal
    otherwise
        probeUrl of s is loadedUrl
    .

    loadedStatus is "healthy"
    try
        loadedStatus is status of item
    otherwise
        loadedStatus is "healthy"
    .
    if loadedStatus is gone or loadedStatus is ""
        loadedStatus is "healthy"
    .
    status of s is loadedStatus

    loadedErr is ""
    try
        loadedErr is lastError of item
    otherwise
        loadedErr is ""
    .
    if loadedErr is gone
        loadedErr is ""
    .
    lastError of s is loadedErr
    return s
.

to loadServicesList filePath
    raw is readOrFallback filePath "[]"
    rawItems are empty
    convert raw from json into rawItems
    services are empty
    for each item in rawItems
        s is createServiceFromDict item
        add s to services
    .
    return services
.

to calculateMetrics services
    svcCount is length of services
    if svcCount is 0
        emptyMetrics has
            totalServices is 0
            healthyServices is 0
            degradedServices is 0
            downServices is 0
            averageLatencyMs is 0
            overallUptime is 100
        .
        return emptyMetrics
    .

    latencies are empty
    uptimes are empty
    healthyCount is 0
    degradedCount is 0
    downCount is 0
    for each s in services
        add latencyMs of s to latencies
        add uptime of s to uptimes
        if status of s is "down"
            downCount is downCount plus 1
        otherwise if status of s is "degraded"
            degradedCount is degradedCount plus 1
        otherwise
            healthyCount is healthyCount plus 1
        .
    .

    avgLat is calcAverage latencies
    avgUp is calcAverage uptimes
    avgLatClamped is clamp avgLat 1 9999

    res has
        totalServices is svcCount
        healthyServices is healthyCount
        degradedServices is degradedCount
        downServices is downCount
        averageLatencyMs is avgLatClamped
        overallUptime is avgUp
    .
    return res
.

to executeHttpProbe targetUrl timeoutSecs
    # Guard against single-threaded self-loopback deadlock if someone targets this server's own port
    lowerTarget is toLower targetUrl
    if lowerTarget starts with "http://127.0.0.1:18092" or lowerTarget starts with "http://localhost:18092"
        selfOutcome has
            reachable is true
            status is "healthy"
            latencyMs is 1
            error is ""
        .
        return selfOutcome
    .

    # Performs a real outbound HTTP GET request via Otter's Http.cs client
    # and measures wall-clock latency with Otter's native high-resolution timer.
    safeTimeout is clamp timeoutSecs 0.2 10
    start timer probeTimer
    probeReachable is false
    probeBody is ""
    probeError is ""
    try
        get targetUrl into probeBody
            with header "User-Agent" is "OtterPulse/1.1"
            with timeout safeTimeout seconds
        probeReachable is true
    otherwise into reason
        probeReachable is false
        probeError is reason
    .
    rawElapsed is elapsed milliseconds of probeTimer
    measuredMs is clamp rawElapsed 1 60000

    probeStatus is "down"
    if probeReachable is true
        probeStatus is "healthy"
        parsedJson is gone
        try
            convert probeBody from json into parsedJson
        otherwise
            parsedJson is gone
        .
        if parsedJson is not gone
            reportedState is ""
            try
                reportedState is status of parsedJson
            otherwise
                reportedState is ""
            .
            if reportedState is not gone and reportedState is not ""
                lowerState is toLower reportedState
                if lowerState is "down" or lowerState is "error" or lowerState is "unhealthy" or lowerState is "fail"
                    probeStatus is "down"
                    try
                        probeError is error of parsedJson
                    otherwise
                        probeError is ""
                    .
                    if probeError is gone or probeError is ""
                        errParts are
                            "Target reported unhealthy status: "
                            reportedState
                        .
                        join errParts with "" into probeError
                    .
                otherwise if lowerState is "degraded" or lowerState is "warning"
                    probeStatus is "degraded"
                    try
                        probeError is detail of parsedJson
                    otherwise
                        probeError is ""
                    .
                    if probeError is gone
                        probeError is ""
                    .
                .
            .
        otherwise
            lowerBody is toLower probeBody
            if lowerBody contains "service unavailable" or lowerBody contains "internal server error"
                probeStatus is "down"
                probeError is "Target returned error page"
            .
        .
        if probeStatus is "healthy" and measuredMs is greater than 120
            probeStatus is "degraded"
        .
    .

    probeOutcome has
        reachable is probeReachable
        status is probeStatus
        latencyMs is measuredMs
        error is probeError
    .
    return probeOutcome
.

to runSelfTest testDbPath
    say "=========================================================="
    say " Otter Pulse Flagship Application Self-Test Verification"
    say " Consuming: file-helpers 1.0.1, text-utils 1.0.1, math-utils 1.0.1"
    say "=========================================================="

    sList are empty
    s1 is createServiceRecord "Auth Gateway" 8081 "api" 99.9 ""
    s2 is createServiceRecord "Payments Service" 8082 "api" 99.5 ""
    s3 is createServiceRecord "Analytics Engine" 8083 "database" 98.5 ""

    add s1 to sList
    add s2 to sList
    add s3 to sList

    if length of sList is not 3
        fail with "OtterPulse: Expected 3 services initialized"
    .
    if slug of s1 is not "auth-gateway"
        fail with "OtterPulse: Slug generation failed"
    .
    if probeUrl of s1 is not "http://127.0.0.1:8081/health"
        fail with "OtterPulse: Default probeUrl mismatch"
    .
    say "1. Microservice definitions created, slugified, and assigned probe URLs."

    metrics is calculateMetrics sList
    if totalServices of metrics is not 3
        fail with "OtterPulse: Metrics totalServices mismatch"
    .
    say "2. Fleet telemetry and metrics calculated successfully."

    saveOk is saveServicesList sList testDbPath
    if saveOk is not true
        fail with "OtterPulse: Save to disk failed"
    .
    loadedSvcs is loadServicesList testDbPath
    if length of loadedSvcs is not 3
        fail with "OtterPulse: Loaded count mismatch"
    .
    firstSvc is first of loadedSvcs
    if probeUrl of firstSvc is not "http://127.0.0.1:8081/health"
        fail with "OtterPulse: Persisted probeUrl mismatch"
    .
    say "3. Multi-service state persisted and restored cleanly from disk."

    # Verify HTTP probe failure handling on an invalid URL scheme without crashing
    badProbe is executeHttpProbe "ftp://127.0.0.1/invalid" 1
    if reachable of badProbe is not false or status of badProbe is not "down"
        fail with "OtterPulse: Invalid URL probe should report down"
    .
    say "4. Native Otter HTTP probe error isolation verified."

    deleteFileSafe testDbPath
    say "=========================================================="
    say " Otter Pulse self-test verification 100% PASSED"
    say "=========================================================="
.

# Database storage path
dbPath is "services_store.json"

# Initialize default services if database is empty
existing is loadServicesList dbPath
if length of existing is 0
    initList are empty
    init1 is createServiceRecord "Auth Gateway" 8081 "api" 99.9 ""
    init2 is createServiceRecord "Payments Service" 8082 "api" 99.8 ""
    init3 is createServiceRecord "Database Primary" 5432 "database" 99.95 ""
    init4 is createServiceRecord "Edge CDN Cache" 6379 "edge" 99.9 ""
    add init1 to initList
    add init2 to initList
    add init3 to initList
    add init4 to initList
    saveServicesList initList dbPath
.

get arguments into cliArgs
if cliArgs contains "--verify" or cliArgs contains "--test"
    runSelfTest "test_dashboard_storage.json"
.

# Web server declaration
dashboardSite is a web server
    port is 18092
    host is "127.0.0.1"
    static is "public"
.

when dashboardSite receives GET at "/api/health"
    healthData has
        status is "healthy"
        version is "1.1.0"
        engine is "Otter 1.0.1 Native"
        probeMode is "live-http"
    .
    respond with healthData as json
.

when dashboardSite receives GET at "/api/services"
    svcs is loadServicesList dbPath
    rawReturn are empty
    for each s in svcs
        d is buildServiceDict s
        add d to rawReturn
    .
    respond with rawReturn as json
.

when dashboardSite receives POST at "/api/services" into req
    bodyObj is a thing
    try
        convert body of req from json into bodyObj
    otherwise
        bodyObj is a thing
    .
    rawName is ""
    try
        rawName is name of bodyObj
    otherwise
        rawName is ""
    .
    rawPort is 0
    try
        rawPort is port of bodyObj plus 0
    otherwise
        rawPort is 0
    .
    rawCat is "api"
    try
        rawCat is category of bodyObj
    otherwise
        rawCat is "api"
    .
    rawUptime is 99.9
    try
        rawUptime is targetUptime of bodyObj
    otherwise
        rawUptime is 99.9
    .
    rawProbeUrl is ""
    try
        rawProbeUrl is probeUrl of bodyObj
    otherwise
        rawProbeUrl is ""
    .

    if rawName is gone or rawName is ""
        err has
            error is "Validation failed: service name is required"
        .
        respond with err as json and status 400
    otherwise if rawPort is less than 1 or rawPort is greater than 65535
        err has
            error is "Validation failed: port must be between 1 and 65535"
        .
        respond with err as json and status 400
    otherwise
        targetSlug is slugify rawName
        currentList is loadServicesList dbPath
        existingSvc is findServiceBySlug currentList targetSlug
        if existingSvc is not gone
            err has
                error is "Duplicate service: a service with this name already exists"
                slug is targetSlug
            .
            respond with err as json and status 409
        otherwise
            newSvc is createServiceRecord rawName rawPort rawCat rawUptime rawProbeUrl
            add newSvc to currentList
            saveServicesList currentList dbPath
            respDict is buildServiceDict newSvc
            respond with respDict as json and status 201
        .
    .
.

when dashboardSite receives PUT at "/api/services" into req
    bodyObj is a thing
    try
        convert body of req from json into bodyObj
    otherwise
        bodyObj is a thing
    .
    targetSlug is ""
    try
        targetSlug is slug of bodyObj
    otherwise
        targetSlug is ""
    .
    newPort is 0
    try
        newPort is port of bodyObj plus 0
    otherwise
        newPort is 0
    .
    newCat is "api"
    try
        newCat is category of bodyObj
    otherwise
        newCat is "api"
    .
    newUptime is 99.9
    try
        newUptime is targetUptime of bodyObj
    otherwise
        newUptime is 99.9
    .
    newProbeUrl is ""
    try
        newProbeUrl is probeUrl of bodyObj
    otherwise
        newProbeUrl is ""
    .

    if targetSlug is gone or targetSlug is ""
        err has
            error is "Validation failed: service slug is required for update"
        .
        respond with err as json and status 400
    otherwise if newPort is less than 1 or newPort is greater than 65535
        err has
            error is "Validation failed: port must be between 1 and 65535"
        .
        respond with err as json and status 400
    otherwise
        svcs is loadServicesList dbPath
        found is findServiceBySlug svcs targetSlug
        if found is gone
            err has
                error is "Service not found"
                slug is targetSlug
            .
            respond with err as json and status 404
        otherwise
            port of found is newPort
            category of found is newCat
            uptime of found is newUptime
            if newProbeUrl is not gone and newProbeUrl is not ""
                probeUrl of found is newProbeUrl
            .
            healthScore of found is calculateHealthScore latencyMs of found newUptime
            saveServicesList svcs dbPath
            respDict is buildServiceDict found
            respond with respDict as json and status 200
        .
    .
.

when dashboardSite receives DELETE at "/api/services" into req
    bodyObj is a thing
    try
        convert body of req from json into bodyObj
    otherwise
        bodyObj is a thing
    .
    targetSlug is ""
    try
        targetSlug is slug of bodyObj
    otherwise
        targetSlug is ""
    .

    if targetSlug is gone or targetSlug is ""
        err has
            error is "Validation failed: service slug is required for deletion"
        .
        respond with err as json and status 400
    otherwise
        svcs is loadServicesList dbPath
        found is findServiceBySlug svcs targetSlug
        if found is gone
            err has
                error is "Service not found"
                slug is targetSlug
            .
            respond with err as json and status 404
        otherwise
            remaining are empty
            for each s in svcs
                if slug of s is not targetSlug
                    add s to remaining
                .
            .
            saveServicesList remaining dbPath
            delRes has
                deleted is true
                slug is targetSlug
            .
            respond with delRes as json and status 200
        .
    .
.

when dashboardSite receives GET at "/api/metrics"
    svcs is loadServicesList dbPath
    metricsData is calculateMetrics svcs
    respond with metricsData as json
.

when dashboardSite receives POST at "/api/services/ping" into req
    bodyObj is a thing
    try
        convert body of req from json into bodyObj
    otherwise
        bodyObj is a thing
    .
    targetSlug is ""
    try
        targetSlug is slug of bodyObj
    otherwise
        targetSlug is ""
    .
    overrideUrl is ""
    try
        overrideUrl is probeUrl of bodyObj
    otherwise
        overrideUrl is ""
    .
    reqTimeout is 2
    try
        reqTimeout is timeoutSeconds of bodyObj plus 0
    otherwise
        reqTimeout is 2
    .
    if reqTimeout is gone or reqTimeout is less than 0.2
        reqTimeout is 2
    .

    if targetSlug is gone or targetSlug is ""
        err has
            error is "Validation failed: slug is required for ping"
        .
        respond with err as json and status 400
    otherwise
        svcs is loadServicesList dbPath
        found is findServiceBySlug svcs targetSlug
        if found is gone
            err has
                error is "Service not found"
                slug is targetSlug
            .
            respond with err as json and status 404
        otherwise
            targetUrl is probeUrl of found
            if overrideUrl is not gone and overrideUrl is not ""
                targetUrl is overrideUrl
                probeUrl of found is overrideUrl
            .
            if targetUrl is gone or targetUrl is ""
                foundPort is port of found
                targetUrl is defaultProbeUrl foundPort
                probeUrl of found is targetUrl
            .

            outcome is executeHttpProbe targetUrl reqTimeout
            measuredLat is latencyMs of outcome
            outcomeStatus is status of outcome
            outcomeReachable is reachable of outcome
            outcomeErr is error of outcome

            latencyMs of found is measuredLat
            status of found is outcomeStatus
            lastError of found is outcomeErr
            checks of found is checks of found plus 1

            if outcomeStatus is "down"
                healthScore of found is 5
            otherwise if outcomeStatus is "degraded"
                baseScore is calculateHealthScore measuredLat uptime of found
                penalizedScore is baseScore minus 25
                healthScore of found is clamp penalizedScore 10 75
            otherwise
                healthScore of found is calculateHealthScore measuredLat uptime of found
            .

            saveServicesList svcs dbPath

            pingRes has
                success is outcomeReachable
                reachable is outcomeReachable
                slug is targetSlug
                probeUrl is targetUrl
                status is outcomeStatus
                latencyMs is measuredLat
                healthScore is healthScore of found
                checks is checks of found
                error is outcomeErr
            .
            respond with pingRes as json and status 200
        .
    .
.
