# list-utils - Otter Reusable Collection Library
# Provides hasItem, dedupeList, countMatches, joinWithPrefix,
# removeItemFromList, findFirstMatch, sortList, reverseList,
# calcListSum, and sliceList
# Internal variables use '_lu_' prefix to prevent collisions with caller/outer variables.

to hasItem items target
    if items contains target
        return true
    .
    return false
.

to dedupeList items
    _lu_result are empty
    for each _lu_it in items
        if not _lu_result contains _lu_it
            add _lu_it to _lu_result
        .
    .
    return _lu_result
.

to countMatches items target
    _lu_matches is 0
    for each _lu_it in items
        if _lu_it is target
            _lu_matches is _lu_matches plus 1
        .
    .
    return _lu_matches
.

to joinWithPrefix items prefix
    _lu_result are empty
    for each _lu_it in items
        _lu_combined is prefix plus _lu_it
        add _lu_combined to _lu_result
    .
    return _lu_result
.

to removeItemFromList items target
    _lu_result are empty
    for each _lu_it in items
        if _lu_it is not target
            add _lu_it to _lu_result
        .
    .
    return _lu_result
.

to findFirstMatch items target
    for each _lu_it in items
        if _lu_it is target
            return _lu_it
        .
    .
    return gone
.

to sortList items
    _lu_copy are empty
    for each _lu_it in items
        add _lu_it to _lu_copy
    .
    sort _lu_copy
    return _lu_copy
.

to reverseList items
    _lu_copy are empty
    for each _lu_it in items
        add _lu_it to _lu_copy
    .
    reverse _lu_copy
    return _lu_copy
.

to calcListSum items
    _lu_total is 0
    for each _lu_it in items
        _lu_total is _lu_total plus _lu_it
    .
    return _lu_total
.

to sliceList items startIndex countLimit
    _lu_result are empty
    _lu_idx is 1
    _lu_endIdx is startIndex plus countLimit
    for each _lu_it in items
        if _lu_idx is at least startIndex
            if _lu_idx is less than _lu_endIdx
                add _lu_it to _lu_result
            .
        .
        _lu_idx is _lu_idx plus 1
    .
    return _lu_result
.
