# ==============================================================================
# Generated by Otter Application Recipe: rpg-adventure 1.0.0
# Target: Complete RPG Game Engine with Combat, Inventory, Cooldowns & XP
# ==============================================================================

use "${import:otter-official/game-entity}"
use "${import:otter-official/math-utils}"
use "${import:otter-official/file-helpers}"

# 1. Initialize Hero and Inventory
hero is createActor "${config:heroName}" 100 1
bag is createInventory 8

starterSword is createItem "Iron Broadsword" "weapon" 15
addItemToInventory bag starterSword

potion is createItem "Health Elixir" "consumable" 25
addItemToInventory bag potion

say "=== RPG Adventure ==="
say "Hero:"
say name of hero
say "Level:"
say level of hero
say "Health:"
say health of hero

# 2. Setup Ability Cooldown
meteorSkill is createCooldown "Meteor Strike" 10
battleTime is 100

# 3. Spawn Boss Opponent
enemy is createActor "${config:enemyName}" ${config:startingEnemyHp} 3
say "A wild monster appears:"
say name of enemy
say "Enemy HP:"
say health of enemy

# 4. Turn 1: Special Ability Check & Execution
canCast is isCooldownReady meteorSkill battleTime
if canCast is true
    triggerCooldown meteorSkill battleTime
    spellDmg is 50
    say "Hero casts Meteor Strike for damage:"
    say spellDmg
    remHp is applyDamage enemy spellDmg
    say "Enemy HP after spell:"
    say remHp
.

# 5. Turn 2: Weapon Strike with Equipment Bonus
baseAttack is 25
weaponBonus is itemPower of starterSword
totalAttack is baseAttack plus weaponBonus
say "Hero strikes with weapon for total damage:"
say totalAttack
remHp is applyDamage enemy totalAttack
say "Enemy HP after strike:"
say remHp

# 6. Turn 3: Finishing Blow
finishingDmg is 50
remHp is applyDamage enemy finishingDmg
say "Finishing blow damage:"
say finishingDmg

# 7. Defeat Condition, Loot Reward, and Level Progression
if isAlive of enemy is false
    say "VICTORY! Enemy defeated:"
    say name of enemy
    
    # Drop loot and add to bag
    bossLoot is createItem "Dragon Scale Shield" "armor" 30
    addItemToInventory bag bossLoot
    say "Loot acquired:"
    say itemName of bossLoot
    say "Inventory item count:"
    say currentCount of bag
    
    # Hero Level Up
    newLevel is levelUp hero
    say "HERO LEVELED UP! New Level:"
    say newLevel
    say "New Max Health:"
    say maxHealth of hero
.

# 8. Save Game State
a SaveRecord has
    heroName
    heroLevel
    heroHp
    invSlots
.
saveRecord is a SaveRecord
heroName of saveRecord is name of hero
heroLevel of saveRecord is level of hero
heroHp of saveRecord is health of hero
invSlots of saveRecord is currentCount of bag
writeJsonObject "rpg_savegame.json" saveRecord

say "Game progress saved to rpg_savegame.json."
say "RPG Adventure loop completed successfully."
