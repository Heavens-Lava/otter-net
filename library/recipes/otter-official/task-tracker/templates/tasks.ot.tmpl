# ==============================================================================
# Generated by Otter Application Recipe: task-tracker 1.0.0
# Target: Console Task Manager Application
# ==============================================================================

use "${import:otter-official/file-helpers}"
use "${import:otter-official/text-utils}"

a TaskItem has
    id
    title
    done
.

to createTask tid and title
    t is a TaskItem
    id of t is tid
    title of t is title
    done of t is "pending"
    give t
.

to completeTask item
    done of item is "completed"
    give item
.

to displayTasks items
    say "=== ${config:appName} ==="
    for each t in items
        status is done of t
        desc is title of t
        tid is id of t
        statusPadded is padRight status and 12
        line is statusPadded plus " | Task #"
        fullLine is line plus tid
        fullLine is fullLine plus ": "
        fullLine is fullLine plus desc
        say fullLine
    .
.

# Initialize default task list
tasks are []
t1 is createTask 1 and "Review project specification"
tasks make t1
t2 is createTask 2 and "Implement composable recipes"
tasks make t2
t3 is createTask 3 and "Verify test suite execution"
tasks make t3

# Mark second task completed
t2 is completeTask t2

# Display tasks in formatted layout
displayTasks tasks
say "Task count: 3"
