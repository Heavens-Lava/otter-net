# ==============================================================================
# Generated by Otter Application Recipe: task-tracker 1.0.0
# Target: Console Task Manager Application with Persistent Storage
# ==============================================================================

use "${import:otter-official/file-helpers}"
use "${import:otter-official/text-utils}"

a TaskItem has
    id
    title
    done
.

to createTask tid title
    t is a TaskItem
    id of t is tid
    title of t is title
    done of t is "pending"
    return t
.

to completeTask tasks targetId
    updated are empty
    for each t in tasks
        tid is id of t
        if tid is targetId
            done of t is "completed"
        .
        add t to updated
    .
    return updated
.

to deleteTask tasks targetId
    remaining are empty
    for each t in tasks
        tid is id of t
        if tid is not targetId
            add t to remaining
        .
    .
    return remaining
.

to filterTasksByStatus tasks targetStatus
    filtered are empty
    for each t in tasks
        s is done of t
        if s is targetStatus
            add t to filtered
        .
    .
    return filtered
.

to displayTasks items headerTitle
    say "=== " plus headerTitle plus " ==="
    countVal is length of items
    if countVal is 0
        say "(No tasks found)"
        return false
    .
    for each t in items
        status is done of t
        desc is title of t
        tid is id of t
        statusPadded is padRight status 12 " "
        descPadded is padRight desc 30 " "
        lineParts are
            "#"
            tid
            ": ["
            statusPadded
            "] "
            descPadded
        .
        join lineParts with "" into line
        say line
    .
    return true
.

to saveTasksToFile tasks filePath
    convert tasks to json into rawJson
    writeSafe filePath rawJson
    return true
.

to loadTasksFromFile filePath
    raw is readOrFallback filePath "[]"
    loaded is a thing
    convert raw from json into loaded
    return loaded
.

# ------------------------------------------------------------------------------
# Application Execution
# ------------------------------------------------------------------------------
storeFile is "tasks_store.json"

tasks is loadTasksFromFile storeFile
taskCount is length of tasks

if taskCount is 0
    say "Initializing default tasks for: ${config:appName}"
    t1 is createTask 1 "Review project specification"
    add t1 to tasks
    t2 is createTask 2 "Implement composable recipes"
    add t2 to tasks
    t3 is createTask 3 "Verify test suite execution"
    add t3 to tasks
    saveTasksToFile tasks storeFile
.

displayTasks tasks "${config:appName} (All Tasks)"

# Complete second task
tasks is completeTask tasks 2
saveTasksToFile tasks storeFile

activeList is filterTasksByStatus tasks "pending"
displayTasks activeList "Active Tasks"

completedList is filterTasksByStatus tasks "completed"
displayTasks completedList "Completed Tasks"

say "Task operation complete. Total stored:"
say length of tasks
