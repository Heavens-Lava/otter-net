# ==============================================================================
# Demo: Contact Manager Application
# ==============================================================================

use "../../../../packs/otter-official/file-helpers/src/main.ot"
use "../../../../packs/otter-official/text-utils/src/main.ot"

a Contact has
    id
    name
    email
    phone
.

to validateEmail emailAddress
    if emailAddress is ""
        return false
    .
    if not emailAddress contains "@"
        return false
    .
    if not emailAddress contains "."
        return false
    .
    split emailAddress by "@" into atParts
    atCount is length of atParts
    if atCount is not 2
        return false
    .
    domain is last of atParts
    split domain by "." into domainParts
    dotCount is length of domainParts
    if dotCount is at least 2
        return true
    .
    return false
.

to createContact cid name email phone
    if not validateEmail email
        say "Error: Invalid email format for contact: "
        say email
        return gone
    .
    c is a Contact
    id of c is cid
    name of c is name
    email of c is email
    phone of c is phone
    return c
.

to searchContacts contacts term
    matches are empty
    for each c in contacts
        cName is name of c
        if cName contains term
            add c to matches
        .
    .
    return matches
.

to editContactPhone contacts targetId newPhone
    updated are empty
    for each c in contacts
        cid is id of c
        if cid is targetId
            phone of c is newPhone
        .
        add c to updated
    .
    return updated
.

to deleteContact contacts targetId
    remaining are empty
    for each c in contacts
        cid is id of c
        if cid is not targetId
            add c to remaining
        .
    .
    return remaining
.

to displayContacts contacts titleText
    say "=== " plus titleText plus " ==="
    countVal is length of contacts
    if countVal is 0
        say "(No contacts found)"
        return false
    .
    for each c in contacts
        cid is id of c
        cName is name of c
        cEmail is email of c
        cPhone is phone of c
        namePadded is padRight cName 18 " "
        emailPadded is padRight cEmail 24 " "
        lineParts are
            "#"
            cid
            ": "
            namePadded
            " | "
            emailPadded
            " | "
            cPhone
        .
        join lineParts with "" into line
        say line
    .
    return true
.

# 1. Initialize and add contacts
directory are empty
c1 is createContact 1 "Ada Lovelace" "ada@analytical.org" "555-0101"
add c1 to directory
c2 is createContact 2 "Charles Babbage" "charles@engines.org" "555-0102"
add c2 to directory
c3 is createContact 3 "Alan Turing" "alan@bletchley.uk" "555-0103"
add c3 to directory

displayContacts directory "All Contacts"

# 2. Search contacts
matches is searchContacts directory "Ada"
displayContacts matches "Search Results for 'Ada'"

# 3. Edit contact phone
directory is editContactPhone directory 2 "555-9999"
displayContacts directory "After Phone Update"

# 4. Delete contact
directory is deleteContact directory 3
displayContacts directory "After Deleting Contact #3"
say "Demo finished successfully."
