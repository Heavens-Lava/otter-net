# ==============================================================================
# Generated by Otter Application Recipe: contact-manager 1.0.0
# Target: Desktop Contact Directory with Validation
# ==============================================================================

use "${import:otter-official/file-helpers}"
use "${import:otter-official/text-utils}"

a Contact has
    name
    email
    phone
.

to validateEmail emailAddress
    parts are emailAddress . split parts by "@" into atParts
    atCount is count of atParts
    if atCount is not 2
        give false
    .
    domain is atParts[1]
    dotParts are domain . split dotParts by "." into domainParts
    dotCount is count of domainParts
    if dotCount is at least 2
        give true
    .
    give false
.

to createContact name and email and phone
    c is a Contact
    name of c is name
    email of c is email
    phone of c is phone
    give c
.

to displayContacts contacts
    say "=== ${config:companyBookName} ==="
    for each c in contacts
        cName is name of c
        cEmail is email of c
        cPhone is phone of c
        namePadded is padRight cName and 16
        emailPadded is padRight cEmail and 24
        line is namePadded plus " | "
        line is line plus emailPadded
        line is line plus " | "
        line is line plus cPhone
        say line
    .
.

# Initialize directory
directory are []

c1 is createContact "Ada Lovelace" and "ada@analytical.org" and "555-0101"
if validateEmail email of c1
    directory make c1
.

c2 is createContact "Charles Babbage" and "charles@engines.org" and "555-0102"
if validateEmail email of c2
    directory make c2
.

displayContacts directory
say "Contacts loaded: 2"
