# Generated by Otter Blueprint: otter-official/file-settings 1.0.0
# Standard editable Otter 1.0.1 source code

use "${import:otter-official/file-helpers}"

configPath is "${settingsFileName}"

defaultConfig has
    theme is "dark"
    autosave is true
    fontSize is 14
.

# Step 1: Read or initialize settings
settings is readJsonObject configPath
if settings is gone
    say "No settings file found. Initializing defaults..."
    writeJsonObject configPath defaultConfig
    settings is defaultConfig
.

say "Active configuration:"
say "  Theme:" theme of settings
say "  Autosave:" autosave of settings
say "  Font Size:" fontSize of settings
