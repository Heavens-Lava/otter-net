{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Otter Application Recipe Manifest",
  "description": "Defines a composable, versioned Otter application recipe composing multiple packs and blueprints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "summary",
    "target",
    "requiresOtter",
    "capabilities",
    "packs",
    "generatedFiles",
    "tests",
    "explanations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "target": {
      "type": "string",
      "enum": ["console", "desktop", "web", "game"]
    },
    "requiresOtter": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["files", "network", "database", "system", "ui"]
      },
      "uniqueItems": true
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "blueprints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "configuration": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "type", "default"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["number", "text", "boolean"]
          },
          "default": {
            "type": ["string", "number", "boolean"]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "description"],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["blueprint-call", "pack-call", "state-init", "event-loop", "io-bridge"]
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "from": { "type": "string" }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "generatedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "template"],
        "properties": {
          "path": {
            "type": "string"
          },
          "template": {
            "type": "string"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "explanations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beginner", "intermediate", "advanced"],
      "properties": {
        "beginner": { "type": "string" },
        "intermediate": { "type": "string" },
        "advanced": { "type": "string" }
      }
    }
  }
}
