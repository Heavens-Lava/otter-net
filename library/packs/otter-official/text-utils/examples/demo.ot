# text-utils Demo
use "../src/main.ot"

say "=== text-utils Demo ==="
say "Repeat 5 times:" repeatText "*=" 5
say "Pad left number:" padLeft "42" 6 "0"
say "Pad right tag:" padRight "INFO" 8 "."
say "Slugify title:" slugify "Otter 1.0 Reusable Library Release"
say "Uppercase:" toUpper "make it loud"
say "Lowercase:" toLower "KEEP IT CALM"
say "Case-insensitive equal:" isEqualIgnoreCase "Release" "RELEASE"
say "Normalize spaces:" normalizeSpaces "Clean    extra   spacing"

tags is splitText "parser,lexer,runtime,cli" ","
say "Split count:" length of tags
say "Rejoined with arrow:" joinText tags " -> "
