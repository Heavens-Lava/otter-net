# text-utils - Otter Reusable String Library
# Provides repeatText, padLeft, padRight, and slugify

to repeatText src timesCount
    result is ""
    count from 1 to timesCount as idx
        result is result plus src
    .
    return result
.

to padLeft text targetLen padChar
    curLen is length of text
    if curLen is at least targetLen
        return text
    .
    needed is targetLen minus curLen
    padding is repeatText padChar needed
    return padding plus text
.

to padRight text targetLen padChar
    curLen is length of text
    if curLen is at least targetLen
        return text
    .
    needed is targetLen minus curLen
    padding is repeatText padChar needed
    return text plus padding
.

to slugify text
    clean is lowercase of text
    replace " " with "-" in clean
    replace "_" with "-" in clean
    return clean
.
