# math-utils Demo
use "../src/main.ot"

say "=== math-utils Demo ==="
say "Clamp 150 to [0, 100]:" clamp 150 0 100
say "Lerp 0 to 200 at 0.5:" lerp 0 200 0.5
say "Map 75 from [0, 100] to [0, 1000]:" mapRange 75 0 100 0 1000
say "Min of 45 and 99:" minVal 45 99
say "Max of 45 and 99:" maxVal 45 99

scores are
    85
    92
    78
    95
.
say "Total sum:" calcSum scores
say "Average score:" calcAverage scores
say "Percentage (45 / 60):" calcPercentage 45 60 "%"
say "Round 7.4:" roundVal 7.4
say "Round up 7.2:" roundUpVal 7.2
say "Round down 7.8:" roundDownVal 7.8
