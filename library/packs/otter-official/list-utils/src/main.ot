# list-utils - Otter Reusable Collection Library
# Provides hasItem, dedupeList, countMatches, joinWithPrefix,
# removeItemFromList, findFirstMatch, sortList, reverseList,
# calcListSum, and sliceList

to hasItem items target
    if items contains target
        return true
    .
    return false
.

to dedupeList items
    result are empty
    for each item in items
        if not result contains item
            add item to result
        .
    .
    return result
.

to countMatches items target
    totalMatches is 0
    for each item in items
        if item is target
            totalMatches is totalMatches plus 1
        .
    .
    return totalMatches
.

to joinWithPrefix items prefix
    result are empty
    for each item in items
        combined is prefix plus item
        add combined to result
    .
    return result
.

to removeItemFromList items target
    result are empty
    for each item in items
        if item is not target
            add item to result
        .
    .
    return result
.

to findFirstMatch items target
    for each item in items
        if item is target
            return item
        .
    .
    return gone
.

to sortList items
    copy are empty
    for each item in items
        add item to copy
    .
    sort copy
    return copy
.

to reverseList items
    copy are empty
    for each item in items
        add item to copy
    .
    reverse copy
    return copy
.

to calcListSum items
    total is 0
    for each item in items
        total is total plus item
    .
    return total
.

to sliceList items startIndex countLimit
    result are empty
    idx is 1
    endIdx is startIndex plus countLimit
    for each item in items
        if idx is at least startIndex
            if idx is less than endIdx
                add item to result
            .
        .
        idx is idx plus 1
    .
    return result
.
