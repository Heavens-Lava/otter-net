# file-helpers Demo
use "../src/main.ot"

say "=== file-helpers Demo ==="
demoFile is "demo_store.json"

config has
    environment is "production"
    logLevel is "info"
    maxRetries is 5
.

say "Saving configuration object to" demoFile "..."
writeJsonObject demoFile config

say "File exists:" fileExistsSafe demoFile

say "Reading configuration back..."
loaded is readJsonObject demoFile
say "Loaded environment:" environment of loaded
say "Loaded log level:" logLevel of loaded
say "Loaded max retries:" maxRetries of loaded

say "Testing corrupt JSON fallback..."
corruptFallback has
    environment is "fallback-env"
.
safeObj is fromJsonSafe "{ malformed" corruptFallback
say "Recovered environment from corrupt JSON:" environment of safeObj

say "Cleaning up demo file..."
deleteFileSafe demoFile
say "File exists after delete:" fileExistsSafe demoFile
