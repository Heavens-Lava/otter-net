# Tests for file-helpers (Strict Behavioral Assertions)
use "../src/main.ot"

say "Running file-helpers behavioral tests..."

testTxtFile is "test_helpers_temp.txt"
testJsonFile is "test_helpers_temp.json"

# Clean up before testing
deleteFileSafe testTxtFile
deleteFileSafe testJsonFile

# 1. Missing file returns fallback
m1 is readOrFallback "non_existent_file_12345.txt" "DEFAULT"
if m1 is not "DEFAULT"
    fail with "readOrFallback failed: expected DEFAULT for non-existent file"
.

# 2. fileExistsSafe
if fileExistsSafe "non_existent_file_12345.txt" is not false
    fail with "fileExistsSafe failed: expected false for missing file"
.

# 3. Write and read text
wOk is writeSafe testTxtFile "Initial text content\n"
if wOk is not true
    fail with "writeSafe failed: write returned false"
.
if fileExistsSafe testTxtFile is not true
    fail with "fileExistsSafe failed: expected file to exist after write"
.
readBack is readOrFallback testTxtFile "FAIL"
if readBack is not "Initial text content\n"
    fail with "readOrFallback mismatch after write"
.

# 4. Append text
aOk is appendSafe testTxtFile "Appended second line\n"
if aOk is not true
    fail with "appendSafe failed: append returned false"
.
appendedContent is readOrFallback testTxtFile "FAIL"
if not appendedContent contains "Appended second line"
    fail with "appendSafe failed: content did not contain appended line"
.

# 5. JSON serialization and deserialization
obj has
    title is "Config Settings"
    port is 8080
    debug is true
.
jsonStr is toJsonSafe obj "{}"
if not jsonStr contains "8080"
    fail with "toJsonSafe failed: output missing port 8080"
.

# 6. Corrupt JSON deserialization safeguard
corruptJson is "{ this is invalid json !!!"
fallbackVal has
    fallbackKey is "active"
.
recoveredObj is fromJsonSafe corruptJson fallbackVal
if fallbackKey of recoveredObj is not "active"
    fail with "fromJsonSafe failed: corrupt JSON did not return fallback value"
.

# 7. Write and read JSON file
wJsonOk is writeJsonObject testJsonFile obj
if wJsonOk is not true
    fail with "writeJsonObject failed: returned false"
.
loadedObj is readJsonObject testJsonFile
if title of loadedObj is not "Config Settings"
    fail with "readJsonObject failed: title mismatch"
.
if port of loadedObj is not 8080
    fail with "readJsonObject failed: port mismatch"
.

# 8. Missing JSON file safe read
missingJsonObj is readJsonObjectSafe "does_not_exist.json" fallbackVal
if fallbackKey of missingJsonObj is not "active"
    fail with "readJsonObjectSafe failed: missing file did not return fallback"
.

# 9. Delete files and confirm removal
deleteFileSafe testTxtFile
deleteFileSafe testJsonFile
if fileExistsSafe testTxtFile is not false
    fail with "deleteFileSafe failed: text file still exists"
.
if fileExistsSafe testJsonFile is not false
    fail with "deleteFileSafe failed: json file still exists"
.

say "All file-helpers behavioral tests passed successfully!"
