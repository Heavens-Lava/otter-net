# game-entity Demo
use "../src/main.ot"

say "=== game-entity Demo ==="
player is createActor "Paladin" 120 1
say "Hero created:" name of player "HP:" health of player "/" maxHealth of player

bag is createInventory 6
potion is createItem "Elixir of Life" "consumable" 50
sword is createItem "Mithril Sword" "weapon" 25
shield is createItem "Kite Shield" "armor" 15
arrows is createStackableItem "Fire Arrow" "ammo" 5 10 20

addItemToInventory bag potion
addItemToInventory bag sword
addItemToInventory bag shield
addItemToInventory bag arrows
say "Inventory items count:" getInventoryCount bag

equip is createEquipment
equipItem equip sword
equipItem equip shield
say "Equipment Attack Bonus: +" getEquipmentAttackBonus equip
say "Equipment Defense Bonus: +" getEquipmentDefenseBonus equip

say "Engaging in combat..."
applyDamage player 35
say "HP after combat damage:" health of player "/" maxHealth of player

restoreHealth player 20
say "HP after recovery:" health of player "/" maxHealth of player

say "Awarding 120 experience..."
gainExperience player 120 100
say "Hero is now Level" level of player "with Max HP:" maxHealth of player

say "Saving full character and inventory state..."
savedState is serializeGameState player bag equip
say "State serialized for:" name of savedState "Level:" level of savedState

bundle is deserializeGameState savedState
heroRestored is actor of bundle
say "Restored hero name:" name of heroRestored "Level:" level of heroRestored
