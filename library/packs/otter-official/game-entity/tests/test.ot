# Tests for game-entity (Strict Behavioral Assertions)
use "../src/main.ot"

say "Running game-entity behavioral tests..."

# 1. Actor creation
hero is createActor "Sir Galahad" 100 1
if name of hero is not "Sir Galahad"
    fail with "createActor failed: name mismatch"
.
if health of hero is not 100
    fail with "createActor failed: health mismatch"
.
if isAlive of hero is not true
    fail with "createActor failed: expected isAlive to be true"
.

# 2. Damage & Death State
applyDamage hero 40
if health of hero is not 60
    fail with "applyDamage failed: expected 60 HP"
.
applyDamage hero 70
if health of hero is not 0
    fail with "applyDamage death failed: expected 0 HP"
.
if isAlive of hero is not false
    fail with "applyDamage death failed: expected isAlive to be false"
.

# 3. Dead Actor cannot be healed without revive
healedDead is restoreHealth hero 50
if healedDead is not 0
    fail with "restoreHealth failed: dead actor was healed"
.
if isAlive of hero is not false
    fail with "dead actor was unexpectedly revived by restoreHealth"
.

# 4. Revive Actor & Healing Cap
reviveActor hero 20
if isAlive of hero is not true
    fail with "reviveActor failed: expected isAlive to be true"
.
if health of hero is not 20
    fail with "reviveActor failed: expected 20 HP"
.
restoreHealth hero 200
if health of hero is not 100
    fail with "restoreHealth cap failed: health exceeded maxHealth 100"
.

# 5. Experience & Leveling
leveledUp is gainExperience hero 150 100
if leveledUp is not true
    fail with "gainExperience failed: expected level-up to trigger"
.
if level of hero is not 2
    fail with "levelUp failed: expected level 2"
.
if maxHealth of hero is not 125
    fail with "levelUp failed: expected maxHealth 125"
.
if attackBonus of hero is not 5
    fail with "levelUp failed: expected attackBonus 5"
.
if defenseBonus of hero is not 3
    fail with "levelUp failed: expected defenseBonus 3"
.
if experience of hero is not 50
    fail with "gainExperience failed: expected 50 remaining experience"
.

# 6. Cooldowns
slashCd is createCooldown "Slash" 3
if isCooldownReady slashCd 10 is not true
    fail with "isCooldownReady initial check failed"
.
triggerCooldown slashCd 10
if isCooldownReady slashCd 11 is not false
    fail with "isCooldownReady check after 1s failed: should be cooling down"
.
if isCooldownReady slashCd 13 is not true
    fail with "isCooldownReady check after 3s failed: should be ready"
.

# 7. Inventory & Capacity
bag is createInventory 2
potion1 is createItem "Health Potion" "consumable" 25
potion2 is createItem "Mana Potion" "consumable" 15
swordItem is createItem "Broadsword" "weapon" 12

ok1 is addItemToInventory bag potion1
if ok1 is not true
    fail with "addItemToInventory 1 failed"
.
ok2 is addItemToInventory bag potion2
if ok2 is not true
    fail with "addItemToInventory 2 failed"
.
# Exceeds capacity
ok3 is addItemToInventory bag swordItem
if ok3 is not false
    fail with "addItemToInventory should fail when capacity is full"
.
if getInventoryCount bag is not 2
    fail with "getInventoryCount mismatch"
.

# 8. Find and Remove Items
foundPot is findItemInInventory bag "Health Potion"
if foundPot is gone
    fail with "findItemInInventory failed to find item"
.
remOk is removeItemFromInventory bag "Health Potion"
if remOk is not true
    fail with "removeItemFromInventory failed to remove item"
.
if getInventoryCount bag is not 1
    fail with "getInventoryCount mismatch after removal"
.
missingPot is findItemInInventory bag "Health Potion"
if missingPot is not gone
    fail with "removed item is still found in inventory"
.

# 9. Stackable Items
arrow1 is createStackableItem "Iron Arrow" "ammo" 1 10 30
arrow2 is createStackableItem "Iron Arrow" "ammo" 1 15 30
addItemToInventory bag arrow1
addItemToInventory bag arrow2
stackedArrow is findItemInInventory bag "Iron Arrow"
if itemCount of stackedArrow is not 25
    fail with "stackable item failed: expected stacked count 25"
.

# 10. Equipment System & Stat Bonuses
equip is createEquipment
weaponItem is createItem "Excalibur" "weapon" 20
armorItem is createItem "Dragon Plate" "armor" 15
equipItem equip weaponItem
equipItem equip armorItem

atkBonus is getEquipmentAttackBonus equip
if atkBonus is not 20
    fail with "getEquipmentAttackBonus failed: expected 20"
.
defBonus is getEquipmentDefenseBonus equip
if defBonus is not 15
    fail with "getEquipmentDefenseBonus failed: expected 15"
.

# 11. State Serialization & Deserialization
savedState is serializeGameState hero bag equip
if name of savedState is not "Sir Galahad"
    fail with "serializeGameState failed: name mismatch"
.

# Restore into fresh objects
restoredBundle is deserializeGameState savedState
restoredHero is actor of restoredBundle
restoredBag is inventory of restoredBundle
restoredEquip is equipment of restoredBundle

if name of restoredHero is not "Sir Galahad"
    fail with "deserializeGameState failed: restored name mismatch"
.
if level of restoredHero is not 2
    fail with "deserializeGameState failed: restored level mismatch"
.
if getEquipmentAttackBonus restoredEquip is not 20
    fail with "deserializeGameState failed: restored equipment attack mismatch"
.
if getEquipmentDefenseBonus restoredEquip is not 15
    fail with "deserializeGameState failed: restored equipment defense mismatch"
.

# 12. Bug 5 Test: reviveActor with 0 HP must not revive actor
fallen is createActor "Fallen Knight" 50 1
applyDamage fallen 50
if isAlive of fallen is not false
    fail with "fallen actor expected dead"
.
reviveZeroRes is reviveActor fallen 0
if reviveZeroRes is not 0
    fail with "reviveActor with 0 HP must return 0"
.
if isAlive of fallen is not false
    fail with "actor must remain dead when revived with 0 HP"
.
if health of fallen is not 0
    fail with "dead actor HP must remain 0"
.

# 13. Bug 4 Test: Multi-leveling in gainExperience (500 XP at 100/level -> level 6)
novice is createActor "Novice Mage" 60 1
multiLvlOk is gainExperience novice 500 100
if multiLvlOk is not true
    fail with "gainExperience failed to trigger multi-leveling"
.
if level of novice is not 6
    fail with "multi-leveling expected level 6 from 500 XP at 100/level"
.
if experience of novice is not 0
    fail with "multi-leveling expected 0 leftover experience"
.

# 14. Bug 2 & 3 Test: Accessory equipping, attack/defense bonuses, and savegame persistence
accEquip is createEquipment
fireRing is createItem "Ring of Fire" "attack_accessory" 12
wardPendant is createItem "Pendant of Warding" "defense_accessory" 8

equipFireOk is equipItem accEquip fireRing
if equipFireOk is not true
    fail with "failed to equip attack_accessory into accessory slot"
.
atkWithAcc is getEquipmentAttackBonus accEquip
if atkWithAcc is not 12
    fail with "attack_accessory bonus failed: expected 12"
.

equipWardOk is equipItem accEquip wardPendant
if equipWardOk is not true
    fail with "failed to equip defense_accessory into accessory slot"
.
defWithAcc is getEquipmentDefenseBonus accEquip
if defWithAcc is not 8
    fail with "defense_accessory bonus failed: expected 8"
.

# Save and restore accessory slot
accSavedState is serializeGameState novice bag accEquip
accRestoredBundle is deserializeGameState accSavedState
accRestoredEquip is equipment of accRestoredBundle
restoredDefAcc is getEquipmentDefenseBonus accRestoredEquip
if restoredDefAcc is not 8
    fail with "restored accessory defense bonus mismatch: expected 8"
.
restoredAccItem is accessory of accRestoredEquip
if itemName of restoredAccItem is not "Pendant of Warding"
    fail with "restored accessory itemName mismatch: expected Pendant of Warding"
.
if itemKind of restoredAccItem is not "defense_accessory"
    fail with "restored accessory itemKind mismatch: expected defense_accessory"
.

# 15. Bug 1 Test: Runtime Scoping & Variable Clash Safety
# Callers can have variables named b, inv, eq, item without clashing with library internal variables
inv is "caller_inv_string"
eq is "caller_eq_string"
item is "caller_item_string"
b is createInventory 3
c is createInventory 4

if inv is not "caller_inv_string"
    fail with "caller inv variable was corrupted by library call"
.
if eq is not "caller_eq_string"
    fail with "caller eq variable was corrupted by library call"
.
if item is not "caller_item_string"
    fail with "caller item variable was corrupted by library call"
.
if capacity of b is not 3
    fail with "first created inventory capacity mismatch"
.
if capacity of c is not 4
    fail with "second created inventory capacity mismatch"
.

say "All game-entity behavioral tests passed successfully!"
